# LinguaLens v1.7.0 local synthetic testbed contract.
# Copy values deliberately; this file contains no production secrets.
LINGUALENS_MOCK_MODE=true

# Reject before job creation when encoded size exceeds 100 MiB or decoded
# duration exceeds 15 minutes.
LINGUALENS_MAX_AUDIO_FILE_SIZE_MB=100
LINGUALENS_MAX_AUDIO_DURATION_SECONDS=900

# WAV and MP3 are the only verified formats in this frozen contract. The API
# rejects M4A, WebM, unknown tokens, empty items, and duplicates. A future
# format requires reviewed decoder evidence and a code/contract allowlist change.
LINGUALENS_SUPPORTED_AUDIO_FORMATS_CSV=wav,mp3
LINGUALENS_AUDIO_NORMALIZATION_SAMPLE_RATE_HZ=16000
LINGUALENS_AUDIO_NORMALIZATION_CHANNELS=1
LINGUALENS_AUDIO_NORMALIZATION_FORMAT=wav_pcm_s16le

# The normal provider boundary is local_faster_whisper. The runtime must fail
# explicitly if its pinned model/profile/decoder is unavailable; no silent
# provider, model, or decoder fallback is allowed.
LINGUALENS_DEFAULT_AUDIO_ASR_PROVIDER=local_faster_whisper
LINGUALENS_ASR_RUNTIME_PROFILE_PATH=artifacts/v1.7.0/asr_runtime_profile.json

LINGUALENS_CHAT_SUBSET_VERSION=lingualens-chat-v1.7.0
LINGUALENS_CHAT_PARSER_VERSION=lingualens-chat-parser-v1.7.0
LINGUALENS_CHAT_SERIALIZER_VERSION=lingualens-chat-serializer-v1.7.0
LINGUALENS_QA_RULE_VERSION=speech-qa-v1.7.0
LINGUALENS_FEATURE_SCHEMA_VERSION=descriptive-features-v1.7.0
LINGUALENS_TOKENIZER_PROFILE_PATH=artifacts/v1.7.0/tokenizer_profile.json

# Browser recording is preserved as experimental_unavailable and does not
# block the local synthetic-file milestone.

# Runtime mode: mock, local_dev, or pilot_backend
VITE_RUNTIME_MODE=mock

# Data/auth modes
VITE_DATA_MODE=mock
VITE_AUTH_MODE=mock
VITE_PROCESSING_MODE=mock
VITE_FILE_STORAGE_MODE=metadata_only

# Backend API base URLs for local_dev or pilot_backend modes
VITE_PROCESSING_API_BASE_URL=
VITE_AUTH_API_BASE_URL=

# Supabase public anon credentials for VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


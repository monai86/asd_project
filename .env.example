# lingualens local demo
LINGUALENS_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_MODE=mock
LINGUALENS_MOCK_MODE=true
LINGUALENS_AUTH_MODE=mock
LINGUALENS_SUPABASE_JWT_VERIFICATION_MODE=hs256_shared_secret
LINGUALENS_SUPABASE_JWT_SECRET=
LINGUALENS_SUPABASE_JWT_JWKS_JSON=
LINGUALENS_SUPABASE_JWT_JWKS_URL=
LINGUALENS_SUPABASE_JWT_JWKS_CACHE_TTL_SECONDS=300
LINGUALENS_SUPABASE_JWT_ISSUER=
LINGUALENS_SUPABASE_JWT_AUDIENCE=authenticated
LINGUALENS_SUPABASE_REQUIRE_MFA=true
LINGUALENS_SUPABASE_REQUIRE_INVITATION=true
LINGUALENS_DEBUG_FEATURE_OVERRIDE=false
LINGUALENS_REPOSITORY_MODE=json
LINGUALENS_JSON_REPOSITORY_PATH=.local/lingualens-app-repository.json
LINGUALENS_DATABASE_URL=postgresql+psycopg://therapist:therapist@localhost/therapist_app_v2
LINGUALENS_JOB_QUEUE_MODE=memory
LINGUALENS_STORAGE_MODE=local_private
LINGUALENS_LOCAL_STORAGE_ROOT=.local/storage
LINGUALENS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LINGUALENS_CSRF_ORIGIN_GUARD_ENABLED=true
LINGUALENS_AI_REPORT_DRAFTING_ENABLED=false
LINGUALENS_RATE_LIMIT_ENABLED=false
LINGUALENS_RATE_LIMIT_REQUESTS=120
LINGUALENS_RATE_LIMIT_WINDOW_SECONDS=60
LINGUALENS_OBSERVABILITY_ENABLED=false
LINGUALENS_OBSERVABILITY_PROVIDER=disabled
LINGUALENS_CRITICAL_ALERT_ROUTE=
LINGUALENS_SECRET_STORE_PROVIDER=local_env
LINGUALENS_CREDENTIAL_ROTATION_RUNBOOK=

# Legacy v2 env names remain supported temporarily for backward compatibility.

# Optional future services
POSTGRES_USER=therapist
POSTGRES_PASSWORD=therapist
POSTGRES_DB=therapist_app_v2
REDIS_URL=redis://redis:6379/0

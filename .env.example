# Therapist App v2 local demo
THERAPIST_APP_V2_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_MODE=mock
THERAPIST_APP_V2_MOCK_MODE=true
THERAPIST_APP_V2_AUTH_MODE=mock
THERAPIST_APP_V2_SUPABASE_JWT_VERIFICATION_MODE=hs256_shared_secret
THERAPIST_APP_V2_SUPABASE_JWT_SECRET=
THERAPIST_APP_V2_SUPABASE_JWT_JWKS_JSON=
THERAPIST_APP_V2_SUPABASE_JWT_JWKS_URL=
THERAPIST_APP_V2_SUPABASE_JWT_JWKS_CACHE_TTL_SECONDS=300
THERAPIST_APP_V2_SUPABASE_JWT_ISSUER=
THERAPIST_APP_V2_SUPABASE_JWT_AUDIENCE=authenticated
THERAPIST_APP_V2_SUPABASE_REQUIRE_MFA=true
THERAPIST_APP_V2_SUPABASE_REQUIRE_INVITATION=true
THERAPIST_APP_V2_DEBUG_FEATURE_OVERRIDE=false
THERAPIST_APP_V2_REPOSITORY_MODE=json
THERAPIST_APP_V2_JSON_REPOSITORY_PATH=.local/therapist-app-v2-repository.json
THERAPIST_APP_V2_DATABASE_URL=postgresql+psycopg://therapist:therapist@localhost/therapist_app_v2
THERAPIST_APP_V2_JOB_QUEUE_MODE=memory
THERAPIST_APP_V2_STORAGE_MODE=local_private
THERAPIST_APP_V2_LOCAL_STORAGE_ROOT=.local/storage
THERAPIST_APP_V2_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
THERAPIST_APP_V2_CSRF_ORIGIN_GUARD_ENABLED=true
THERAPIST_APP_V2_AI_REPORT_DRAFTING_ENABLED=false
THERAPIST_APP_V2_RATE_LIMIT_ENABLED=false
THERAPIST_APP_V2_RATE_LIMIT_REQUESTS=120
THERAPIST_APP_V2_RATE_LIMIT_WINDOW_SECONDS=60
THERAPIST_APP_V2_OBSERVABILITY_ENABLED=false
THERAPIST_APP_V2_OBSERVABILITY_PROVIDER=disabled
THERAPIST_APP_V2_CRITICAL_ALERT_ROUTE=
THERAPIST_APP_V2_SECRET_STORE_PROVIDER=local_env
THERAPIST_APP_V2_CREDENTIAL_ROTATION_RUNBOOK=

# Optional future services
POSTGRES_USER=therapist
POSTGRES_PASSWORD=therapist
POSTGRES_DB=therapist_app_v2
REDIS_URL=redis://redis:6379/0
